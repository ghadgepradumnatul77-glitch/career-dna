# Career DNA Frontend Environment Configuration

# FastAPI Backend Base URL (Used when VITE_USE_MOCK_API is false)
VITE_API_BASE_URL=http://localhost:8000

# Toggle Mock API vs Real Backend (true = standalone demo mode, false = connect to FastAPI)
VITE_USE_MOCK_API=true

# Simulated analysis delay for smooth hackathon demo progress (in milliseconds)
VITE_PROCESSING_DELAY=2500
