PROJECT_NAME="Career DNA API"
API_V1_STR="/api/v1"
SECRET_KEY="career_dna_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL credentials (if password contains special characters, setting POSTGRES_PASSWORD will auto URL-encode it)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_postgres_password_here"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="career_dna"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/career_dna"
SQLITE_FALLBACK_URL="sqlite:///./career_dna.db"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173"]

